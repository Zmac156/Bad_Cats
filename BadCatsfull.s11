<46AA>			_ENDIF
<46AA>			_WVM_MODE 
<46AD>			setThreadFlags Thread#F4 
<46AF>			killThreads #$FF  Thread#F4 
<46B2>			_If Flag#0E 													; OPTIMIZE?
<46B5>				clearBits Flag#0E 
<46B7>			_EndIf
<46B7>	ballSearch_restart:														; wait 15s
<46B7>			load Reg-A #15 
<46B9>			load Reg-B #3 													; re-try three times
<46BB>	ballSearch_wait:														; [A] seconds
<46BB>			sleep 63 
<46BD>			_If %gameOver 
<46C0>				exitThread 
<46C1>			_EndIf
<46C1>			decAndBranchUnlessZero Reg-A ballSearch_wait 
<46C4>			branchIf %logicOr: %switchClosed: Switch#38 %switchClosed: Switch#39 ballSearch_restart 
<46CB>			branchIf %logicOr: Flag#0D Flag#0C ballSearch_restart 
<46D0>			setBits Flag#0E 
<46D2>			begin6800 
<46D3>				CLR		__game_in_progress 
<46D6>			end6800
