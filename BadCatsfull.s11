<453A>	spawn_higher_priority_FX_thread:										; if active FX priority > B_in, return CS
<453A>			CMPB	active_FX_priority 
<453D>			_IF_CS	
<453F>				SEC															; BUG? (unnecessary instruction)
<4540>				RTS		
<4540>		
<4541>			_ENDIF
<4541>			PSHB	
<4542>			PSHA	
<4543>			STAB	active_FX_priority 										; if B_in >= active FX priority
<4546>			STX		RAM_011F 
<4549>			BSR		kill_thread[B]_and_others 								; abort running FX
<454B>			BSR		clear_displays_altBuf 
