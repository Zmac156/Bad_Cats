<7ADB>	lit_inlanes_TOY_award:
<7ADB>			begin6800 
<7ADC>				LDAA	BBRAM_Adj36_bonusx_difficulty 						; Adjustment 36, Bonus multiplier difficulty
<7ADF>			end6800
<7ADF>			_If %equal: Reg-A #$02 											; NORMAL: do not award a TOY lamp
<7AE4>				exitThread 
<7AE5>			_EndIf
<7AE5>			sleep 3 														; give ball time to pass switch?
<7AE6>			_Unless %equal: Reg-A #$00 										; unless EASIEST
<7AEB>				toggleBits Lamp#19 Lamp#1C 
<7AEE>			_EndUnless
<7AEE>			load Reg-A #12 													; find first unlit TOY lamp on PF
<7AF0>			_Loop
<7AF0>				addTo Reg-A #1 
<7AF2>			_While [Reg-A] 
<7AF5>			_If %greaterThan: Reg-A #$0F 									; they are all lit (not possible, but maybe during race condition?)
<7AFA>				exitThread 
<7AFB>			_EndIf
<7AFB>			load Reg-B Reg-A 												; unlit TOY lamp on PF
<7AFD>			addTo Reg-B #3 													; corresponding lamp on back panel
<7AFF>			jump TOY_noSkillshot 											; simulate switch closure
